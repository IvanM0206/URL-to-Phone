{
  "manifest_version": 3,
  "name": "QR Tab",
  "version": "1.0",
  "description": "Genera un código QR de la URL actual para abrirla fácilmente en tu celular.",
  "permissions": ["tabs"],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "QR Tab",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
